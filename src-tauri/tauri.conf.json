{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Greenlit",
  "version": "0.1.0",
  "identifier": "com.tagban.greenlit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Greenlit",
        "width": 480,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "SimulationGame",
    "shortDescription": "Run a movie studio from a garage to the top of the box office.",
    "copyright": "Greenlit contributors"
  }
}